
# --- WitUS ecosystem: Inbox (inbound feedback/help/bug -> BAM triage) ---
# Any of the three unset = forwards are stubbed (logged, not sent).
# The slug must match an entry in the Inbox's INGEST_SOURCES exactly, or every send is a 401.
# The value below is a placeholder: confirm it against what was provisioned on the Inbox
# (the Inbox's provisioning template lists `ride-witus`).
INBOX_INGEST_URL=https://inbox.witus.online/api/ingest
INBOX_SOURCE_SLUG=ride-wit-us
INBOX_INGEST_SECRET=

# --- WitUS ecosystem: Outbox (outbound social drafts -> BAM accounts) ---
# General channel (ad hoc posts). Slug must match the Outbox's INGEST_SOURCES; placeholder as above.
OUTBOX_INGEST_URL=https://outbox.witus.online/api/ingest
OUTBOX_SOURCE_SLUG=ride-wit-us
OUTBOX_INGEST_SECRET=
# Podcast channel (episode_published, season_complete): its own slug + secret so it can be
# rotated on its own. Unset = podcast drafts are stubbed.
OUTBOX_PODCAST_RWU_SLUG=
OUTBOX_PODCAST_RWU_SECRET=
# Kill-switch. Only the exact value `true` lets /api/outbox/publish send. Unset = off.
OUTBOX_TRIGGER_ENABLED=
# Optional bearer token for calling /api/outbox/publish from a script
# (Authorization: Bearer <token>). Unset = only the signed-in admin can call it.
# Generate with: openssl rand -base64 32
OUTBOX_PUBLISH_TOKEN=

# --- Error monitoring: Better Stack (Sentry-compatible ingest) ---
# All optional. With no DSN the Sentry SDK never initializes and nothing is transmitted.
# SENTRY_DSN is the server/edge DSN; NEXT_PUBLIC_SENTRY_DSN is inlined into the browser bundle.
# Both come from the same Better Stack source; the value is an ingest endpoint, not an account secret.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional label on every event; defaults to VERCEL_ENV then NODE_ENV.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Only needed if source maps are uploaded to a Sentry-protocol project that accepts them.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- WitUS ecosystem: Sign in with WitUS (the ONLY authentication this app has) ---
# All three must be set together. With any one missing, /signin shows no sign-in button,
# the "Continue as <name>" probe never fires, and no request is made to accounts.witus.online.
# Confirm with: curl -s https://ride.witus.online/api/health | jq .config.witus_sso
#
# client_id is fixed by the IdP registry (gemini/witus lib/identity/clients.ts): witus-ride.
WITUS_OIDC_CLIENT_ID=witus-ride
# Issued by BAM on the IdP as WITUS_OIDC_SECRET__RIDE; paste the same value here.
WITUS_OIDC_CLIENT_SECRET=
# Signs this app's session cookie. Generate 32+ random bytes, e.g.
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotating it signs everyone out; it is not shared with any other app.
WITUS_SESSION_SECRET=

# Admin owner. ONE address; the signed-in session's email is compared to it
# case-insensitively (lib/auth/admin.ts). Unset or blank = NOBODY is an admin, which is
# the safe default for an unprovisioned deploy. Not a claim from the IdP: the IdP does not
# know who administers this app.
ADMIN_EMAIL=
# Optional. The IdP's OIDC issuer — every IdP URL (authorize/token/userinfo/endsession) and the
# ecosystem session probe origin derive from this one value. Override only for a staging IdP.
# WITUS_OIDC_ISSUER=https://accounts.witus.online/api/idp
# Optional. This app's canonical public origin, used to build BOTH the OIDC redirect_uri and the
# post_logout_redirect_uri. Unset, both derive from the request host, which is correct on
# ride.witus.online and deliberately wrong (so sign-in fails closed) on a preview deployment.
# NEXT_PUBLIC_SITE_URL=https://ride.witus.online

# --- Mobility database: Neon Postgres (the mobility app under /app and the waitlist) ---
# Unset = /app shows "not switched on", /api/waitlist returns 503, and the build still passes.
# Pooled connection string, read at runtime.
# The Vercel Neon integration on this project adds a STORAGE_ prefix (STORAGE_DATABASE_URL,
# STORAGE_DATABASE_URL_UNPOOLED). Either spelling works; the unprefixed name wins when both are set.
DATABASE_URL=
# Direct (unpooled) URL, used only by `pnpm db:migrate:prod`. BAM exports it in his shell; never commit it.
DATABASE_URL_UNPOOLED=
# HMAC key for rate-limit bucket keys, so stored keys cannot be reversed to client IPs.
# Generate with: openssl rand -base64 32
RATE_LIMIT_SALT=
