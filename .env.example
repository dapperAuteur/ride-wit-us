
# --- WitUS ecosystem: Inbox (inbound feedback/help/bug -> BAM triage) ---
INBOX_INGEST_URL=https://inbox.witus.online/api/ingest
INBOX_SOURCE_SLUG=ride-wit-us
INBOX_INGEST_SECRET=

# --- WitUS ecosystem: Outbox (outbound social drafts -> BAM accounts) ---
OUTBOX_INGEST_URL=https://outbox.witus.online/api/ingest
OUTBOX_SOURCE_SLUG=ride-wit-us
OUTBOX_INGEST_SECRET=
OUTBOX_TRIGGER_ENABLED=true

# --- Error monitoring: Better Stack (Sentry-compatible ingest) ---
# All optional. With no DSN the Sentry SDK never initializes and nothing is transmitted.
# SENTRY_DSN is the server/edge DSN; NEXT_PUBLIC_SENTRY_DSN is inlined into the browser bundle.
# Both come from the same Better Stack source; the value is an ingest endpoint, not an account secret.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional label on every event; defaults to VERCEL_ENV then NODE_ENV.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Only needed if source maps are uploaded to a Sentry-protocol project that accepts them.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
