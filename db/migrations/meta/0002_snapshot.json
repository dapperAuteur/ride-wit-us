        "trips_cost_currency_paired": {
          "name": "trips_cost_currency_paired",
          "value": "(\"trips\".\"cost_amount\" IS NULL) = (\"trips\".\"cost_currency\" IS NULL) AND (\"trips\".\"cost_currency\" IS NULL OR \"trips\".\"cost_currency\" ~ '^[A-Z]{3}$')"
        },
        "trips_budget_currency_paired": {
          "name": "trips_budget_currency_paired",
          "value": "(\"trips\".\"budget_amount\" IS NULL) = (\"trips\".\"budget_currency\" IS NULL) AND (\"trips\".\"budget_currency\" IS NULL OR \"trips\".\"budget_currency\" ~ '^[A-Z]{3}$')"
        },
        "trips_end_after_start": {
          "name": "trips_end_after_start",
          "value": "\"trips\".\"end_date\" IS NULL OR \"trips\".\"end_date\" >= \"trips\".\"start_date\""
        },
        "trips_distance_nonnegative": {
          "name": "trips_distance_nonnegative",
          "value": "\"trips\".\"distance_m\" IS NULL OR \"trips\".\"distance_m\" >= 0"
        },
        "trips_assist_ebike_only": {
          "name": "trips_assist_ebike_only",
          "value": "\"trips\".\"assist_level\" IS NULL OR \"trips\".\"mode\" = 'ebike'"
        },
        "trips_arrive_after_depart": {
          "name": "trips_arrive_after_depart",
          "value": "\"trips\".\"arrived_at\" IS NULL OR \"trips\".\"departed_at\" IS NULL OR \"trips\".\"arrived_at\" >= \"trips\".\"departed_at\""
        },
        "trips_calories_source_paired": {
          "name": "trips_calories_source_paired",
          "value": "(\"trips\".\"calories_kcal\" IS NULL) = (\"trips\".\"calories_source\" IS NULL)"
        }
      },
